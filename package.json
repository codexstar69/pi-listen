{
  "name": "@codexstar/pi-listen",
  "version": "2.1.2",
  "description": "Voice input for Pi \u2014 hold SPACE to talk, Deepgram streaming STT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "voice",
    "stt",
    "deepgram",
    "speech-to-text"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "release:dry": "bun run check && bun publish --dry-run",
    "release": "bun run check && bun publish --access public"
  },
  "homepage": "https://github.com/codexstar69/pi-listen",
  "repository": {
    "type": "git",
    "url": "https://github.com/codexstar69/pi-listen.git"
  },
  "bugs": {
    "url": "https://github.com/codexstar69/pi-listen/issues"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./extensions/voice.ts"
    ]
  },
  "files": [
    "extensions",
    "docs",
    "scripts",
    "README.md",
    "package.json"
  ]
}
